APP_ENV=local
LOCAL_DB_PATH=local_data/sleep_support.sqlite3
LOCAL_SERVER_HOST=127.0.0.1
LOCAL_SERVER_PORT=8000
# Вставь сюда токен от @BotFather. Если оставить пустым, запустится только локальный API без Telegram polling.
TELEGRAM_BOT_TOKEN=
ADMIN_TOKEN=change-me-local-admin-token
BILLING_PROVIDER=mock
LOG_LEVEL=INFO
METRICS_ENABLED=true
CONTENT_PATH=content
ENCRYPTION_KEY=local-development-key-change-me
